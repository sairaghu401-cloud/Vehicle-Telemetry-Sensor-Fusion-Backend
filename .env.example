# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry_dev_password
POSTGRES_DB=telemetry
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_dev_secret_do_not_use_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
